#!/usr/bin/env python3
import fcntl
import glob
import os
import signal
import subprocess
import sys
import time
import numpy as np

FRAME_BYTES = 640 * 480 * 2
F_SETPIPE_SZ = 1031

def find_ov7251_subdev():
    for name_file in glob.glob("/sys/class/video4linux/v4l-subdev*/name"):
        try:
            with open(name_file, "r") as f:
                if "ov7251" in f.read():
                    return "/dev/" + os.path.basename(os.path.dirname(name_file))
        except OSError:
            pass
    return None

def set_ov7251(subdev, exposure, gain):
    if not subdev:
        return
    subprocess.run(
        ["/usr/bin/v4l2-ctl", "-d", subdev, f"--set-ctrl=exposure={int(exposure)},analogue_gain={int(gain)}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

def has_reader(ignore_pids):
    for fd_path in glob.glob("/proc/[0-9]*/fd/*"):
        pid = fd_path.split("/")[2]
        if pid in ignore_pids:
            continue
        try:
            if os.readlink(fd_path) == "/dev/video66":
                return True
        except OSError:
            pass
    return False

r_fd, w_fd = os.pipe()
try:
    fcntl.fcntl(w_fd, F_SETPIPE_SZ, 1048576)
except OSError:
    pass

# ov7251 on Surface Book 3 is mounted 90 deg CCW -> rotate upright to 480x640
gst = subprocess.Popen([
    "/usr/bin/gst-launch-1.0", "-q",
    "fdsrc", f"blocksize={FRAME_BYTES}", "!",
    "rawvideoparse", "format=gray16-le", "width=480", "height=640", "framerate=30/1", "!",
    "videoconvert", "!",
    "video/x-raw,format=YUY2", "!",
    "v4l2sink", "device=/dev/video66", "sync=false",
], stdin=subprocess.PIPE)

cam = subprocess.Popen([
    "/usr/bin/cam", "-c", r"\_SB_.PCI0.I2C3.CAM3", "--capture", f"--file=/proc/self/fd/{w_fd}"
], pass_fds=(w_fd,), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

os.close(w_fd)
time.sleep(0.4)
subdev = find_ov7251_subdev()
cur_exp = 500
cur_gain = 256
set_ov7251(subdev, cur_exp, cur_gain)
ignore_pids = {str(os.getpid()), str(gst.pid), str(cam.pid)}

try:
    with os.fdopen(r_fd, "rb", buffering=0) as f:
        frame_idx = 0
        saw_reader = False
        while True:
            buf = bytearray()
            while len(buf) < FRAME_BYTES:
                chunk = f.read(FRAME_BYTES - len(buf))
                if not chunk:
                    sys.exit(0)
                buf.extend(chunk)
            arr = (np.frombuffer(buf, dtype=np.uint16) & 0x03FF).astype(np.float32)
            if frame_idx in (1, 3, 5, 8) or (frame_idx > 8 and frame_idx % 6 == 0):
                if not subdev:
                    subdev = find_ov7251_subdev()
                p95 = float(np.percentile(arr, 95))
                new_exp, new_gain = cur_exp, cur_gain
                if p95 > 860:
                    new_exp = max(40, int(cur_exp * 0.5))
                    if new_exp == 40:
                        new_gain = max(64, int(cur_gain * 0.6))
                elif p95 < 480:
                    if cur_exp < 1600:
                        new_exp = min(1600, int(cur_exp * 1.6))
                    else:
                        new_gain = min(512, int(cur_gain * 1.4))
                if (new_exp, new_gain) != (cur_exp, cur_gain):
                    cur_exp, new_gain = new_exp, new_gain
                    set_ov7251(subdev, cur_exp, cur_gain)
            if frame_idx == 5:
                open("/run/surface-ir.ready", "w").close()
            frame_idx += 1
            lo, hi = np.percentile(arr, (2, 98))
            if hi > lo + 20:
                arr = np.clip((arr - lo) * (65535.0 / (hi - lo)), 0, 65535)
            else:
                arr = arr * 64.0
            upright = np.rot90(arr.reshape(480, 640), 1).astype(np.uint16)
            gst.stdin.write(upright.tobytes())
            gst.stdin.flush()
            if frame_idx > 8 and frame_idx % 5 == 0:
                if has_reader(ignore_pids):
                    saw_reader = True
                elif saw_reader:
                    break
finally:
    try:
        os.unlink("/run/surface-ir.ready")
    except OSError:
        pass
    for proc in (cam, gst):
        if proc.poll() is None:
            proc.send_signal(signal.SIGTERM)
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
